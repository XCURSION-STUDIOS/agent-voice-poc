# Core
ENVIRONMENT=development
SYSTEM_PROMPT="You are a personal AI assistant. You are having a natural spoken conversation with the user. Speak naturally and conversationally. Keep responses concise unless the user asks for detail. Do not use markdown formatting when speaking. Do not unnecessarily repeat the user's question. Do not announce that you are an AI unless relevant. If the user interrupts you, immediately adapt to what they are saying. Prioritize natural conversation over overly formal responses."

# Transport
TRANSPORT=webrtc

# LLM (normal streaming text API, never OpenAI Realtime)
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Streaming STT
STT_PROVIDER=deepgram
DEEPGRAM_API_KEY=

# Streaming TTS (OpenAI by default; set TTS_PROVIDER=deepgram to compare)
TTS_PROVIDER=openai
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=marin
OPENAI_TTS_INSTRUCTIONS="Speak in a warm, natural British accent. Conversational, clear, and unhurried."

# Deepgram TTS comparison option (uses the same Deepgram key as STT)
DEEPGRAM_TTS_VOICE=aura-2-arcas-en

# Turn taking. Tune these from real conversations, not synthetic tests.
MIN_START_WORDS=2
